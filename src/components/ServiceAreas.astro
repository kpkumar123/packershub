---
// src/components/ServiceAreas.astro
//
// v10.7.31 — redesigned per owner feedback: the three category groups
// (Premium Residential / Commercial Hub / High-Density Residential) used
// to imply three separate cards. Now rendered as ONE combined card with
// three internal sections, each with its own emoji header and pill-style
// area badges — a single cohesive "Our Service Areas in {city}" block.
//
// Works directly with the merged /src/data/service-areas/all-100-cities.json file.
// Usage on any existing city page (e.g. src/pages/[state]/[city].astro):
//
//   import ServiceAreas from '../../components/ServiceAreas.astro';
//   import allAreas from '../../data/service-areas/all-100-cities.json';
//
//   <ServiceAreas allData={allAreas} citySlug={city.slug} cityName={city.name} />

export interface Area {
  name: string;
  category: 'affluent' | 'commercial' | 'high-population';
}
export interface CityAreas {
  city: string;
  slug: string;
  confidence: 'verified' | 'moderate' | 'low';
  areas: Area[];
}
export interface AllAreasData {
  heading_template: string;
  intro_template: string;
  states: { state: string; city_count: number; cities: CityAreas[] }[];
}
export interface Props {
  allData: AllAreasData;
  citySlug: string;   // must match the "slug" field in the JSON, e.g. "nellore"
  cityName?: string;  // optional override for display name
}
const { allData, citySlug, cityName } = Astro.props;

// Find the city's area data across all 5 states
let cityData: CityAreas | undefined;
for (const state of allData.states) {
  cityData = state.cities.find((c) => c.slug === citySlug);
  if (cityData) break;
}

const displayCity = cityName ?? cityData?.city ?? citySlug;
const heading = allData.heading_template.replace('{city}', displayCity);
const intro = allData.intro_template.replace('{city}', displayCity);

// Group flat area list into the three category sections
const groupOrder: Area['category'][] = ['affluent', 'commercial', 'high-population'];
const groupMeta: Record<Area['category'], { icon: string; title: string; badgeClass: string }> = {
  'affluent': {
    icon: '💎',
    title: 'Affluent Areas',
    badgeClass: 'service-areas__pill--affluent',
  },
  'commercial': {
    icon: '🏢',
    title: 'Commercial Hubs',
    badgeClass: 'service-areas__pill--commercial',
  },
  'high-population': {
    icon: '🏠',
    title: 'High-Population Areas',
    badgeClass: 'service-areas__pill--high-population',
  },
};

const grouped = cityData
  ? groupOrder
      .map((cat) => ({
        category: cat,
        meta: groupMeta[cat],
        areas: cityData!.areas.filter((a) => a.category === cat),
      }))
      .filter((g) => g.areas.length > 0)
  : [];
---
{cityData && (
  <section class="service-areas" aria-labelledby="service-areas-heading">
    <div class="text-center mb-10 reveal">
      <span class="inline-block px-4 py-1.5 rounded-full bg-orange-100 text-brand-orange text-sm font-bold mb-4 uppercase tracking-wide">
        📍 Locality Coverage
      </span>
      <h2 id="service-areas-heading" class="font-display text-3xl lg:text-4xl font-extrabold text-brand-dark mb-4">
        {heading}
      </h2>
      <p class="service-areas__intro max-w-2xl mx-auto">{intro}</p>
    </div>

    <div class="service-areas__card card-lift reveal" itemscope itemtype="https://schema.org/ItemList">
      {grouped.map((group, gi) => (
        <div class:list={["service-areas__group", { "service-areas__group--first": gi === 0 }]}>
          <h3 class="service-areas__group-title">
            <span class="service-areas__group-icon" aria-hidden="true">{group.meta.icon}</span>
            {group.meta.title}
          </h3>
          <ul class="service-areas__pills">
            {group.areas.map((area, i) => (
              <li
                class={`service-areas__pill ${group.meta.badgeClass}`}
                itemprop="itemListElement"
                itemscope
                itemtype="https://schema.org/ListItem"
              >
                <meta itemprop="position" content={String(i + 1)} />
                <span itemprop="name">{area.name}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
)}

<style>
  .service-areas { padding: 1rem 0; }
  .service-areas__intro { color: #4b5563; }

  .service-areas__card {
    background: #fff;
    border: 1px solid #eef0f3;
    border-radius: 1.75rem;
    box-shadow: var(--shadow-card);
    padding: 0.5rem 1.75rem 1.75rem;
    overflow: hidden;
    position: relative;
  }
  .service-areas__card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 5px;
    background: linear-gradient(90deg, #b45309, #E8510A, #047857);
  }

  .service-areas__group {
    padding: 1.5rem 0;
    border-top: 1px dashed #e5e7eb;
  }
  .service-areas__group--first { border-top: none; }

  .service-areas__group-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15rem;
    color: #0D1117;
    margin-bottom: 1rem;
  }
  .service-areas__group-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.85rem;
    background: #F8FAFC;
    font-size: 1.15rem;
    flex-shrink: 0;
  }

  .service-areas__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .service-areas__pill {
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    white-space: nowrap;
    transition: transform .2s ease;
  }
  .service-areas__pill:hover { transform: translateY(-2px); }

  .service-areas__pill--affluent {
    color: #92400e;
    background: linear-gradient(135deg, #fef3e2, #fde3c2);
    border: 1px solid #f6d9a8;
  }
  .service-areas__pill--commercial {
    color: #1e3a8a;
    background: linear-gradient(135deg, #eaf1ff, #dbe8ff);
    border: 1px solid #c6d9ff;
  }
  .service-areas__pill--high-population {
    color: #065f46;
    background: linear-gradient(135deg, #e7f8f1, #d3f2e3);
    border: 1px solid #b9e8d2;
  }

  @media (max-width: 640px) {
    .service-areas__card { padding: 0.5rem 1.1rem 1.25rem; border-radius: 1.25rem; }
    .service-areas__group-title { font-size: 1.05rem; }
  }
</style>
