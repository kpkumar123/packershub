---
// v10.7.14 — Module 41 (pagination audit) fix.
// Replaces the old unpaginated index.astro. Currently only 5 posts exist
// (page 1 covers all of them, so this looks identical to before), but the
// infra is now real: once posts pass PAGE_SIZE, Astro's paginate() emits
// /blog/2/, /blog/3/, etc. automatically with rel=prev/next wired into
// SEOHead — no future rebuild needed when the blog grows.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async ({ paginate }) => {
  const PAGE_SIZE = 9; // 3x3 grid at lg breakpoint
  try {
    const posts = (await getCollection('blog')).sort(
      (a, b) => new Date(b.data?.pubDate || 0).getTime() - new Date(a.data?.pubDate || 0).getTime()
    );
    return paginate(posts, { pageSize: PAGE_SIZE });
  } catch (err: any) {
    throw new Error(`DEBUG_ERROR: ${err.message}`);
  }
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const posts = page.data;

const pageTitle = page.currentPage === 1
  ? 'Blog — Packing Tips, Moving Guides & Relocation Advice | PackersHub'
  : `Blog — Page ${page.currentPage} | PackersHub`;
---
<BaseLayout
  title={pageTitle}
  description="Expert moving tips, packing guides, and relocation advice from PackersHub — South India's trusted packers and movers serving 100 cities."
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Blog', url: '/blog/' }]}
  prevUrl={page.url.prev}
  nextUrl={page.url.next}
  noindex={page.currentPage > 1 && posts.length === 0}
>
  <section class="bg-gradient-to-br from-orange-50 via-white to-orange-50 py-20">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-display font-extrabold text-brand-dark mb-4">PackersHub Blog</h1>
      <p class="text-brand-grey text-lg">Expert tips, guides, and local moving advice from South India's most trusted packers and movers.</p>
    </div>
  </section>
  <section class="py-16 bg-gray-50">
    <div class="max-w-5xl mx-auto px-4">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post, i) => (
          <a href={`/blog/${post.id}/`} class="reveal bg-white rounded-2xl shadow-card overflow-hidden hover:shadow-glass hover:-translate-y-1 transition-all duration-200" style={`transition-delay:${i*0.05}s`}>
            {post.data.image ? (
              <Image src={post.data.image} alt={post.data.title} class="h-40 w-full object-cover" loading="lazy" width={400} height={160} />
            ) : (
              <div class="bg-gradient-to-br from-brand-orange to-brand-gold h-40 flex items-center justify-center">
                <span class="text-5xl">{['📦','🚚','🏠','🗓️','💡'][i % 5]}</span>
              </div>
            )}
            <div class="p-5">
              <span class="text-xs font-bold text-brand-orange uppercase tracking-wide">{post.data.category}</span>
              <h2 class="font-bold text-brand-dark font-display mt-2 mb-2 line-clamp-2">{post.data.title}</h2>
              <p class="text-brand-grey text-sm line-clamp-3">{post.data.description}</p>
              <div class="flex items-center justify-between mt-4 pt-4 border-t border-gray-100">
                <span class="text-gray-400 text-xs">{new Date(post.data.pubDate).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'})}</span>
                <span class="text-brand-orange text-xs font-bold">{post.data.readTime} min read →</span>
              </div>
            </div>
          </a>
        ))}
      </div>
      {posts.length === 0 && (
        <div class="text-center py-20">
          <p class="text-brand-grey text-lg">Blog posts coming soon. Check back shortly!</p>
        </div>
      )}
      {(page.url.prev || page.url.next) && (
        <nav class="flex justify-center items-center gap-4 mt-12" aria-label="Blog pagination">
          {page.url.prev
            ? <a href={page.url.prev} class="px-5 py-2.5 rounded-full border border-gray-200 font-semibold text-brand-dark hover:border-brand-orange hover:text-brand-orange transition-colors">← Newer</a>
            : <span />}
          <span class="text-brand-grey text-sm">Page {page.currentPage} of {page.lastPage}</span>
          {page.url.next
            ? <a href={page.url.next} class="px-5 py-2.5 rounded-full border border-gray-200 font-semibold text-brand-dark hover:border-brand-orange hover:text-brand-orange transition-colors">Older →</a>
            : <span />}
        </nav>
      )}
    </div>
  </section>
</BaseLayout>
