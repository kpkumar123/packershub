---
// src/pages/admin/integrations.astro
// v10.7.6 — new file. Staff-only tool, excluded from search via noindex AND
// Disallow: /admin/ in robots.txt. Not linked from any public nav menu.
//
// WHY THIS EXISTS: every integration in this codebase (GA4, Razorpay,
// WhatsApp/MSG91 follow-ups, the Twilio voice agent, GPS tracking, Google
// Indexing API) is written to no-op silently if its env var is missing —
// correct behavior for a build that shouldn't crash over one unconfigured
// optional feature. The tradeoff: staff have had no way to tell
// "integration is off because it's unconfigured" from "integration is
// broken" without opening the Cloudflare Pages dashboard by hand.
//
// This page is a shell only — same staff-token pattern as /admin/orders/
// and /admin/seo-ops/. The actual configured/missing status is fetched
// client-side from /api/admin/integrations.ts using the token, so nothing
// sensitive (not even "which keys are missing") renders before the token
// is verified server-side. See that file for the boolean-only guarantee —
// this page never sees or displays an actual secret value, only whether
// each key is set.
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Staff — Integration Status"
  description="Internal tool: which env vars/integrations are configured vs missing."
  noindex={true}
>
  <section class="py-16 bg-gray-50 min-h-screen">
    <div class="max-w-3xl mx-auto px-4">
      <h1 class="text-2xl font-display font-extrabold text-brand-dark mb-2">Integration Status</h1>
      <p class="text-brand-grey mb-8 text-sm">
        Enter your staff token to load status. This never shows secret values — only whether each key is set.
      </p>

      <div class="bg-white rounded-2xl shadow-card border border-gray-100 p-6 mb-6">
        <label class="block text-sm font-semibold text-brand-dark mb-1.5">Staff Token</label>
        <div class="flex gap-2">
          <input type="password" id="admin-token" class="flex-1 px-4 py-2.5 rounded-xl border border-gray-200 outline-none focus:border-brand-orange" placeholder="Paste staff token" />
          <button id="save-token" class="px-4 py-2.5 rounded-xl border border-gray-200 font-semibold hover:border-brand-orange hover:text-brand-orange transition-colors" type="button">Load</button>
        </div>
        <p class="text-xs text-brand-grey mt-1.5" id="token-status"></p>
      </div>

      <div id="summary" class="hidden bg-white rounded-2xl shadow-card border border-gray-100 p-5 mb-6">
        <p class="text-sm font-bold text-brand-dark" id="summary-text"></p>
      </div>

      <div id="gaps" class="hidden bg-red-50 border border-red-200 rounded-2xl p-6 mb-6">
        <h2 class="font-bold text-red-700 mb-2 text-sm">⚠ Required integrations incomplete</h2>
        <ul class="text-sm text-red-700 space-y-1 list-disc list-inside" id="gaps-list"></ul>
      </div>

      <div id="groups" class="space-y-4"></div>

      <p class="text-xs text-brand-grey mt-8">
        To set a value: Cloudflare Pages → your project → Settings → Environment variables, or
        <code class="bg-gray-100 px-1.5 py-0.5 rounded">wrangler pages secret put KEY_NAME</code>.
        See <code class="bg-gray-100 px-1.5 py-0.5 rounded">.env.example</code> in the repo for what each key is for and where to get it.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  interface Row { key: string; configured: boolean; }
  interface Group { name: string; feature: string; allRequired: boolean; rows: Row[]; }

  const tokenInput = document.getElementById('admin-token') as HTMLInputElement;
  const loadBtn = document.getElementById('save-token')!;
  const status = document.getElementById('token-status')!;
  const groupsEl = document.getElementById('groups')!;
  const summaryEl = document.getElementById('summary')!;
  const summaryText = document.getElementById('summary-text')!;
  const gapsEl = document.getElementById('gaps')!;
  const gapsList = document.getElementById('gaps-list')!;
  const STORAGE_KEY = 'ph_admin_token';

  function escapeHtml(s: string) {
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  function render(groups: Group[]) {
    const totalKeys = groups.reduce((n, g) => n + g.rows.length, 0);
    const totalConfigured = groups.reduce((n, g) => n + g.rows.filter(r => r.configured).length, 0);
    summaryText.textContent = `${totalConfigured} of ${totalKeys} keys configured.`;
    summaryEl.classList.remove('hidden');

    const criticalGaps = groups.filter(g => g.allRequired && g.rows.some(r => !r.configured));
    if (criticalGaps.length > 0) {
      gapsList.innerHTML = criticalGaps.map(g => `<li>${escapeHtml(g.name)}</li>`).join('');
      gapsEl.classList.remove('hidden');
    } else {
      gapsEl.classList.add('hidden');
    }

    groupsEl.innerHTML = groups.map(g => {
      const groupOk = g.rows.every(r => r.configured);
      const borderClass = groupOk ? 'border-gray-100' : (g.allRequired ? 'border-red-200' : 'border-amber-200');
      const badgeClass = groupOk ? 'bg-green-100 text-green-700' : (g.allRequired ? 'bg-red-100 text-red-700' : 'bg-amber-100 text-amber-700');
      const badgeText = groupOk ? 'Configured' : (g.allRequired ? 'Missing (required)' : 'Missing (optional)');
      const rowsHtml = g.rows.map(r => `
        <li class="flex items-center gap-2 text-xs font-mono">
          <span aria-hidden="true">${r.configured ? '✅' : '❌'}</span>
          <span class="${r.configured ? 'text-brand-dark' : 'text-red-600'}">${escapeHtml(r.key)}</span>
        </li>`).join('');
      return `
        <div class="bg-white rounded-2xl shadow-card border ${borderClass} p-5">
          <div class="flex items-center justify-between mb-1">
            <h3 class="font-bold text-brand-dark text-sm">${escapeHtml(g.name)}</h3>
            <span class="text-xs font-bold px-2 py-1 rounded-full ${badgeClass}">${badgeText}</span>
          </div>
          <p class="text-xs text-brand-grey mb-3">${escapeHtml(g.feature)}</p>
          <ul class="space-y-1">${rowsHtml}</ul>
        </div>`;
    }).join('');
  }

  async function loadStatus() {
    const token = tokenInput.value.trim();
    if (!token) { status.textContent = 'Enter your staff token first.'; return; }
    localStorage.setItem(STORAGE_KEY, token);
    status.textContent = 'Loading…';
    try {
      const res = await fetch('/api/admin/integrations', { headers: { 'x-admin-token': token } });
      if (res.status === 401) { status.textContent = 'Invalid token.'; return; }
      if (!res.ok) { status.textContent = 'Failed to load status.'; return; }
      const data = await res.json();
      if (!data.ok) { status.textContent = data.error || 'Failed to load status.'; return; }
      status.textContent = 'Loaded.';
      render(data.groups as Group[]);
    } catch {
      status.textContent = 'Network error — try again.';
    }
  }

  const saved = localStorage.getItem(STORAGE_KEY);
  if (saved) {
    tokenInput.value = saved;
    loadStatus();
  }

  loadBtn.addEventListener('click', loadStatus);
  tokenInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') loadStatus(); });
</script>
